PORT=3000
# Optional: enables real LLM copy generation. The app works without it.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

# Operational controls
RATE_WINDOW_MS=60000
RATE_LIMIT_API=120
RATE_LIMIT_SCAN=20
RATE_LIMIT_GENERATE=60
SHUTDOWN_TIMEOUT_MS=10000
# Keep disabled on public deployments unless sanitized metrics are intentionally exposed.
METRICS_PUBLIC=0
